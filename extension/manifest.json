{
  "manifest_version": 3,
  "name": "Faktencheck lokal",
  "version": "0.1.0",
  "description": "Markierten Text per Rechtsklick prüfen – mit der in Chrome eingebauten lokalen KI (Gemini Nano). Ohne Cloud, ohne Konto.",
  "minimum_chrome_version": "138",
  "permissions": ["contextMenus", "sidePanel", "storage"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "Faktencheck lokal öffnen" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
